{
  "name": "turnscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "description": "Local-first observability for development agents",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "pnpm build:server && pnpm build:desktop",
    "build:desktop": "electron-vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev": "electron-vite dev",
    "dev:api": "tsx src/cli.ts serve --dev --token turnscope-local-dev",
    "dev:web": "vite",
    "postinstall": "install-electron",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:electron": "node tests/electron/import-worker-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.electron.json && vue-tsc -p tsconfig.web.json --noEmit",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm test:electron",
    "turnscope": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@filipgutica/ui": "0.3.0",
    "@tanstack/vue-table": "^9.2.4",
    "@tanstack/vue-virtual": "^3.13.36",
    "@vueuse/core": "14.4.0",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "fastify": "5.12.1",
    "marked": "18.0.11",
    "vue": "3.5.42",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "electron": "44.1.1",
    "electron-vite": "5.0.0",
    "happy-dom": "20.12.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
