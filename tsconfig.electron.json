{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "electron"],
    "noEmit": true
  },
  "include": ["electron/**/*.ts", "src/**/*.ts", "shared/**/*.ts", "electron.vite.config.ts"]
}
